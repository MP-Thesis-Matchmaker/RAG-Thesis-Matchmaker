# Copy this file to .env and fill in what you need.
# .env is gitignored. Never commit real keys.
#
# Grouped by the member that owns the variable, which is also the member whose
# config.py declares it. A prefix means exactly one package reads it:
#
#   (no prefix)  themis_shared   -- read by more than one member
#   MATCHER_     themis_matcher  -- the engine: parsing, embedding, retrieval, synthesis
#   GATEWAY_     themis_gateway  -- the MCP front door
#   ZORA_        themis_zora     -- the ZORA harvester
#   SCRAPER_     themis_scraper  -- the posting scraper
#
# Setting a variable under the wrong prefix is silent: extra="ignore" means it is
# not rejected, just not read. get_settings() warns about the pre-2026-08-27
# unprefixed spellings for exactly that reason.

# ---------------------------------------------------------------------------
# Shared -- the only two variables more than one member reads
# ---------------------------------------------------------------------------

# Postgres (with the pgvector extension) holding the vector index and the
# harvested source rows. Apply the schema with: themis-init-db
# docker-compose.yml starts a matching local instance.
#
# Unprefixed on purpose, and pinned that way with a validation_alias so a member
# prefix cannot rename it: this is the spelling the k8s Secret, the CI job,
# docker-compose and conftest.py all already use.
DATABASE_URL=postgresql://matchmaker:matchmaker@localhost:5432/matchmaker

# Where the matcher's HTTP service lives, for everyone who calls it: the gateway,
# and the harvester and scraper, which POST an index trigger when a run lands.
# Empty means "not configured" -- the gateway then says so, and the producers
# skip the trigger rather than failing a harvest that otherwise succeeded.
MATCHER_BASE_URL=

# ---------------------------------------------------------------------------
# themis_matcher -- the engine
# ---------------------------------------------------------------------------

# LLM endpoint for parsing the student's query (OpenAI-compatible).
# Production: point at LibreChat / the AI Buddy gateway.
# Development: point at a free local model, e.g. Ollama:
#   MATCHER_LLM_BASE_URL=http://localhost:11434/v1
# Leave it empty to use the offline rule-based parser (no LLM needed).
#
# Not the same LLM as SCRAPER_LLM_* further down, and that is why both carry a
# prefix: this one reads a student's sentence, that one reads a web page.
MATCHER_LLM_BASE_URL=
MATCHER_LLM_MODEL=llama3.1
MATCHER_LLM_API_KEY=

# Only for reasoning models (Qwen3, o-series, DeepSeek-R1). "none" turns hidden
# reasoning off; "low"/"medium"/"high" bound it. Leave empty for models that do
# not reason -- some endpoints reject fields they do not know (we retry without
# it, but that costs a round trip). Measured with qwen3:8b on Ollama: synthesis
# takes ~31 s with reasoning on and ~6 s with it set to none, and the client's
# 30 s timeout means "on" silently degrades to the offline template.
MATCHER_LLM_REASONING_EFFORT=

# Candidates scoring below this are not presented as matches by the LLM
# synthesiser (the answer says there is no strong match instead). 0 disables.
# Only meaningful with real embeddings -- hash-fake scores are arbitrary.
MATCHER_SYNTHESIS_MIN_SCORE=0

# Whether a publication needs a registered UZH author to be retrievable.
# Off by default: ineligible publications are indexed and reachable, and
# MATCHER_RETRIEVAL_RANKING_STRATEGY below is what keeps them out of the way.
# Flipping this needs no re-index - the index takes no position either way.
# Caveat when true: pgvector filters after the HNSW scan and the partial
# indexes key on source_type only, so a filtered query can come back short.
# The retriever over-fetches to compensate. See retrieval/README.md.
MATCHER_RETRIEVAL_REQUIRE_UZH_AUTHOR=false

# How matches are ordered once grouped per person.
#   uzh_first - UZH-affiliated people rank above everyone else, similarity
#               breaks ties inside each group (default; the product
#               recommends UZH supervisors)
#   score     - plain similarity, ignoring affiliation
# Inert while MATCHER_RETRIEVAL_REQUIRE_UZH_AUTHOR=true, which leaves nothing
# non-UZH for the strategy to order. A typo fails at load rather than silently
# selecting a fallback.
MATCHER_RETRIEVAL_RANKING_STRATEGY=uzh_first

# Whether a thesis posting has to still be available to be retrievable.
# On by default: an assigned or private topic is not a recommendation under
# any query, and no ranking strategy demotes them - false puts them in the
# results outright. Flipping this needs no re-index either: every posting is
# embedded and carries is_available in its metadata.
MATCHER_RETRIEVAL_REQUIRE_AVAILABLE_POSTING=true

# Embedding model for semantic search (provisional default).
# Requires the 'embeddings' extra (uv sync --extra embeddings); the model
# (~4 GB) downloads to ~/.cache/huggingface on first use.
# Set to hash-fake for the deterministic offline embedder (no download,
# no real semantics) - used by tests, CI, and quick demos.
MATCHER_EMBEDDING_MODEL=BAAI/bge-m3

# Torch device the embedding model loads onto. Unset = auto-detect, which is
# right on the cluster (CPU-only) and usually right locally. Set cpu on a Mac
# if a run dies with no error message at all: auto-detect picks mps there, and
# an mps load on a memory-starved machine aborts the process rather than
# raising, so nothing gets logged.
# MATCHER_EMBEDDING_DEVICE=cpu

# Embedding batch shape. Both bound the transient attention buffer, which is
# batch x heads x seq^2 -- at the model's own 8192 default the longest abstract
# in the corpus asked for 88.77 GiB on its own. 1024 is measured: p50=240,
# p95=632, p99=905 tokens over a 2% sample, so it truncates 0.69% of documents.
#
# Changing the token cap invalidates every vector in the index, and the vector
# column is vector(1024). The manifest guards it, because the cap changes
# embeddings WITHOUT changing content_hash, so a re-index would otherwise skip
# every document and leave a silently mixed-cap index.
# MATCHER_EMBEDDING_MAX_SEQ_LENGTH=1024
# MATCHER_EMBEDDING_BATCH_SIZE=16

# Documents embedded and committed per round trip. The indexer streams rather
# than embedding the whole corpus before its first write, which keeps peak
# memory flat and makes an interrupted run resumable through the content hash.
# MATCHER_INDEX_CHUNK_SIZE=1000

# How long an index run may go without committing a chunk before it is presumed
# dead and its single-active slot released. Bounds the gap between two chunks,
# not the length of a run: a cold index takes days but breathes every chunk.
# MATCHER_INDEX_RUN_HEARTBEAT_TIMEOUT_S=900

# Directory with the ingestion output the indexer reads
# (publications.jsonl / theses.jsonl). Defaults to the 50 checked-in samples,
# which are real records exported from the corpus. Use `db` for the full tables.
MATCHER_SOURCES_PATH=data/samples

# The matcher's own HTTP service: match, recommend, and the index triggers.
# 8100 rather than 8000 so it does not collide with the gateway on a laptop.
# Use 0.0.0.0 as the host in a container -- projects/matcher/Dockerfile does.
# MATCHER_API_HOST=127.0.0.1
# MATCHER_API_PORT=8100

# ---------------------------------------------------------------------------
# themis_gateway -- the MCP front door
# ---------------------------------------------------------------------------

# MCP server (standalone service the AI Buddy agent points at). Tools are served
# at http://<host>:<port>/mcp. Use 0.0.0.0 as the host when running in a
# container -- projects/gateway/Dockerfile already does.
GATEWAY_MCP_HOST=127.0.0.1
GATEWAY_MCP_PORT=8000

# ---------------------------------------------------------------------------
# themis_zora -- the ZORA harvester
# ---------------------------------------------------------------------------

# ZORA personal API token, needed only by the harvester
# (python -m themis_zora harvest). Get one from your ZORA
# profile page. Set either variable; the file wins if both are set. Leaving one
# empty means "not set" rather than "the current directory".
ZORA_UZH_API_KEY_FILE=
ZORA_UZH_API_KEY=

# Root of the harvester's disk footprint. Only the raw-response cache lives
# there now (under <dir>/raw) -- output and the watermark are in Postgres -- and
# it exists so a re-run does not re-hit ZORA. Relative to the working directory,
# like MATCHER_SOURCES_PATH above. The k8s CronJobs point it at an emptyDir.
ZORA_DATA_DIR=data

# There is deliberately no variable for the ZORA API origin. It is a ClassVar in
# themis_zora/config.py, so pydantic registers no field and there is nothing here
# to set: a harvest pointed at another DSpace would write that server's records
# into `publication` under our provenance with nothing in the log to say so.
# The undocumented DSPACE_API_ENDPOINT override was removed on 2026-08-27.

# ---------------------------------------------------------------------------
# themis_scraper -- the posting scraper
# ---------------------------------------------------------------------------

# REQUIRED before the scraper will fetch anything. It is advertised in the
# User-Agent so a site owner can reach a human, and `user_agent` raises rather
# than sending a blank contact. Use a project address, not a personal one.
SCRAPER_CONTACT=

# Root of the scraper's data tree: registry/, specs/, cache/, var/, output/.
# Relative to the working directory, like MATCHER_SOURCES_PATH above.
SCRAPER_DATA_ROOT=data/scraper

# Politeness. Lower the delay only with a reason: fetching is sequential and
# every source is hit once per run.
SCRAPER_POLITE_DELAY_SECONDS=2.0
SCRAPER_HTTP_TIMEOUT_SECONDS=30

# The LLM the scraper uses, which is NOT the one the matchmaker uses -- it writes
# application-process summaries, drafts a spec at onboarding, and backs the
# run-time extraction fallback. Any OpenAI-compatible endpoint.
# SCRAPER_LLM_API_KEY wins over OPENAI_API_KEY when both are set. With neither,
# every caller keeps its deterministic output and flags the source instead.
SCRAPER_LLM_API_KEY=
SCRAPER_LLM_PROVIDER=openai
SCRAPER_LLM_MODEL=gpt-5-mini
SCRAPER_LLM_BASE_URL=

# Retry budget and timeout for one completion. Transient errors back off
# exponentially; auth failures are never retried.
# SCRAPER_LLM_MAX_ATTEMPTS=3
# SCRAPER_LLM_TIMEOUT_SECONDS=120

# How much of a page reaches the model. Budgets, not limits on the page: text
# beyond them is dropped. The HTML budgets are larger than the text one because
# those calls need the links, not just the prose.
# SCRAPER_LLM_PAGE_TEXT_BUDGET=6000
# SCRAPER_LLM_FALLBACK_HTML_BUDGET=14000
# SCRAPER_SPEC_DRAFT_HTML_BUDGET=16000

# JS-rendered pages, only meaningful with the `render` extra installed.
SCRAPER_RENDER_IDLE_MS=6000
SCRAPER_RENDER_SETTLE_MS=700

# How many previous versions of a page the cache keeps, for change detection.
SCRAPER_CACHE_HISTORY_KEEP=3

# Person profiles followed during onboarding; the --profile-limit flag overrides it.
SCRAPER_PROFILE_LIMIT=3
